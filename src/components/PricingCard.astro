---
// HMR Update
interface Props {
	title: string;
	price: string;
	description: string;
	features: string[];
	isPopular?: boolean;
}

const { title, price, description, features, isPopular = false } = Astro.props;
---

<div class={`pricing-card ${isPopular ? 'popular' : ''}`}>
	{isPopular && <div class="badge-popular">Más Elegido</div>}
	
	<div class="card-header">
		<h3>{title}</h3>
		<p>{description}</p>
		<div class="price">
			<span class="amount">{price}</span>
		</div>
	</div>
	
	<ul class="features">
		{features.map((feature) => (
			<li>
				<div class="check-circle">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
					</svg>
				</div>
				{feature}
			</li>
		))}
	</ul>
	
	<a href="#contacto" class={`btn-plan ${isPopular ? 'btn-popular' : 'btn-outline'}`}>Comenzar Ahora</a>
</div>

<style>
	.pricing-card {
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		padding: 3rem 2.5rem;
		position: relative;
		transition: all 0.3s ease;
		border: 1px solid rgba(0,0,0,0.05);
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-sm);
	}

	.pricing-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-lg);
	}

	/* Estilos especiales para el plan popular */
	.pricing-card.popular {
		background: var(--grad-purple);
		color: white;
		border: none;
		transform: scale(1.05);
		box-shadow: var(--shadow-md);
		z-index: 2;
	}

	.pricing-card.popular:hover {
		transform: scale(1.05) translateY(-8px);
		box-shadow: 0 20px 40px rgba(142, 45, 226, 0.4);
	}

	.badge-popular {
		position: absolute;
		top: -15px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--grad-accent);
		color: white;
		padding: 0.5rem 1.5rem;
		border-radius: 30px;
		font-weight: 800;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		box-shadow: 0 4px 10px rgba(241, 39, 17, 0.3);
		animation: pulse-glow 2s infinite;
	}

	.card-header {
		text-align: center;
		margin-bottom: 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(0,0,0,0.05);
	}

	.popular .card-header {
		border-bottom-color: rgba(255,255,255,0.2);
	}

	h3 {
		font-size: 1.5rem;
		font-weight: 800;
		margin-bottom: 1rem;
		color: var(--color-text-primary);
	}

	.popular h3 { color: white; }

	.card-header p {
		color: var(--color-text-secondary);
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
	}

	.popular .card-header p { color: rgba(255,255,255,0.8); }

	.amount {
		font-size: 3.5rem;
		font-weight: 800;
		color: var(--color-text-primary);
		line-height: 1;
	}

	.popular .amount { color: white; }

	.features {
		list-style: none;
		margin-bottom: 2.5rem;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 1.2rem;
	}

	.features li {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		color: var(--color-text-secondary);
		font-weight: 500;
	}

	.popular .features li { color: white; }

	.check-circle {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: rgba(0, 198, 255, 0.1);
		color: #0072ff;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.popular .check-circle {
		background: rgba(255,255,255,0.2);
		color: white;
	}

	.check-circle svg {
		width: 14px;
		height: 14px;
	}

	.btn-plan {
		text-align: center;
		padding: 1rem;
		border-radius: 50px;
		font-weight: 700;
		transition: all 0.3s;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.9rem;
	}

	.btn-popular {
		background: white;
		color: #4A00E0;
	}

	.btn-popular:hover {
		box-shadow: 0 0 20px rgba(255,255,255,0.5);
	}

	.btn-outline {
		background: transparent;
		color: var(--color-text-primary);
		border: 2px solid rgba(0,0,0,0.1);
	}

	.btn-outline:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	@media (max-width: 1024px) {
		.pricing-card.popular {
			transform: scale(1);
		}
		.pricing-card.popular:hover {
			transform: translateY(-8px);
		}
	}

	@media (max-width: 768px) {
		.pricing-card {
			padding: 2rem 1.5rem;
		}
		.amount {
			font-size: 2.5rem;
		}
		.card-header {
			margin-bottom: 1.5rem;
			padding-bottom: 1.5rem;
		}
		.features {
			margin-bottom: 1.5rem;
			gap: 0.8rem;
		}
	}
</style>
