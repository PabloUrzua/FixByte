---
import Layout from '../../layouts/Layout.astro';
import { createSupabaseClient } from '../../lib/supabase';

// The middleware guarantees that the user is logged in and is an admin
// We can use locals to get the session
const session = Astro.locals.session;
const supabase = Astro.locals.supabase;

// Mock data to show the UI if Supabase is not fully configured yet
const mockTickets = [
  { id: 1, empresa: 'Acme Corp', asunto: 'Problema con facturación', estado: 'abierto', fecha: '2026-08-19' },
  { id: 2, empresa: 'Globex', asunto: 'Error en sistema de inventario', estado: 'cerrado', fecha: '2026-08-18' },
];

const mockEmpresas = [
  { id: 1, nombre: 'Acme Corp', correos: ['admin@acme.com', 'soporte@acme.com'] },
  { id: 2, nombre: 'Globex', correos: ['contacto@globex.com'] },
];

---

<Layout title="Panel de Administración">
  <div class="min-h-screen bg-slate-50 flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-slate-200 shadow-sm hidden md:block">
      <div class="p-6">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-purple-600 flex items-center justify-center text-white font-bold text-xl">
            A
          </div>
          <span class="font-bold text-xl text-slate-800">AdminPanel</span>
        </div>
        
        <nav class="space-y-2">
          <a href="#" class="flex items-center gap-3 px-4 py-3 bg-blue-50 text-blue-700 rounded-xl font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            Dashboard
          </a>
          <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-xl font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            Empresas
          </a>
          <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-600 hover:bg-slate-50 rounded-xl font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
            Tickets
          </a>
        </nav>
      </div>
      
      <div class="absolute bottom-0 w-64 p-6 border-t border-slate-200">
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="flex items-center gap-3 px-4 py-3 text-red-600 hover:bg-red-50 w-full rounded-xl font-medium transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            Cerrar Sesión
          </button>
        </form>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8 overflow-y-auto">
      <header class="flex justify-between items-center mb-10">
        <div>
          <h2 class="text-3xl font-bold text-slate-800">Hola, Administrador</h2>
          <p class="text-slate-500 mt-1">Aquí puedes gestionar las empresas y los tickets de soporte.</p>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Tickets Recientes -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
              <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
              Tickets Recientes
            </h3>
            <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded-full">{mockTickets.length} Totales</span>
          </div>
          
          <div class="space-y-4">
            {mockTickets.map(ticket => (
              <div class="p-4 rounded-xl border border-slate-100 hover:border-blue-200 hover:shadow-md transition-all group bg-slate-50 hover:bg-white cursor-pointer">
                <div class="flex justify-between items-start mb-2">
                  <h4 class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">{ticket.asunto}</h4>
                  <span class={`px-2.5 py-1 text-xs font-bold rounded-full ${ticket.estado === 'abierto' ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700'}`}>
                    {ticket.estado.toUpperCase()}
                  </span>
                </div>
                <div class="flex justify-between items-center text-sm text-slate-500">
                  <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    {ticket.empresa}
                  </span>
                  <span>{ticket.fecha}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Empresas y Correos -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
              <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Empresas Registradas
            </h3>
            <button class="px-4 py-2 bg-slate-900 text-white text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors shadow-sm">
              + Nueva Empresa
            </button>
          </div>

          <div class="space-y-4">
            {mockEmpresas.map(empresa => (
              <div class="p-4 rounded-xl border border-slate-100 bg-slate-50">
                <div class="flex items-center gap-3 mb-3">
                  <div class="w-10 h-10 rounded-lg bg-white border border-slate-200 flex items-center justify-center font-bold text-slate-600 shadow-sm">
                    {empresa.nombre.charAt(0)}
                  </div>
                  <div>
                    <h4 class="font-bold text-slate-800">{empresa.nombre}</h4>
                    <p class="text-xs text-slate-500">{empresa.correos.length} correos vinculados</p>
                  </div>
                </div>
                <div class="pt-3 border-t border-slate-200">
                  <div class="flex flex-wrap gap-2">
                    {empresa.correos.map(correo => (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-slate-200 text-xs font-medium text-slate-600 rounded-full shadow-sm">
                        <svg class="w-3 h-3 text-slate-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" /><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" /></svg>
                        {correo}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
