---
import Layout from '../../layouts/Layout.astro';

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect('/login');
}
---

<Layout title="Cuenta Pendiente">
  <div class="pending-page">
    <!-- Animated background shapes -->
    <div class="bg-shape shape-1"></div>
    <div class="bg-shape shape-2"></div>
    <div class="bg-shape shape-3"></div>

    <div class="pending-card">
      <!-- Animated clock icon -->
      <div class="icon-wrapper">
        <div class="icon-pulse"></div>
        <div class="icon-circle">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>

      <h1>Confirmación Pendiente</h1>
      <p class="subtitle">Tu registro fue exitoso</p>

      <div class="info-box">
        <div class="info-row">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          <span>{session.user.email}</span>
        </div>
        <div class="info-row">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          <span>Autenticación completada</span>
        </div>
      </div>

      <div class="steps">
        <div class="step completed">
          <div class="step-dot">
            <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" /></svg>
          </div>
          <div class="step-text">
            <span class="step-title">Registro Completado</span>
            <span class="step-desc">Tu cuenta ha sido creada</span>
          </div>
        </div>
        <div class="step-line"></div>
        <div class="step active">
          <div class="step-dot pulsing">
            <span>2</span>
          </div>
          <div class="step-text">
            <span class="step-title">Confirmación Pendiente</span>
            <span class="step-desc">Un administrador debe vincular tu cuenta a una empresa</span>
          </div>
        </div>
        <div class="step-line faded"></div>
        <div class="step">
          <div class="step-dot inactive">
            <span>3</span>
          </div>
          <div class="step-text">
            <span class="step-title">Acceso al Portal</span>
            <span class="step-desc">Podrás abrir tickets de soporte</span>
          </div>
        </div>
      </div>

      <p class="note">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Este proceso suele tardar menos de 24 horas. Si necesitas ayuda inmediata, contacta a soporte.
      </p>

      <div class="actions">
        <form method="POST" action="/api/auth/signout" style="width:100%;">
          <button type="submit" class="btn-logout">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            Cerrar Sesión
          </button>
        </form>
        <a href="/" class="btn-home">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Volver al Inicio
        </a>
      </div>
    </div>

    <p class="footer-text">FixByte &mdash; Soporte Técnico Empresarial</p>
  </div>
</Layout>

<style>
  .pending-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    position: relative;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  /* Animated background shapes */
  .bg-shape {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: float 20s ease-in-out infinite;
  }

  .shape-1 {
    width: 500px;
    height: 500px;
    background: #6366f1;
    top: -150px;
    right: -100px;
    animation-delay: 0s;
  }

  .shape-2 {
    width: 400px;
    height: 400px;
    background: #3b82f6;
    bottom: -100px;
    left: -100px;
    animation-delay: -7s;
  }

  .shape-3 {
    width: 300px;
    height: 300px;
    background: #8b5cf6;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: -14s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -30px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(20px, 10px) scale(1.02); }
  }

  /* Card */
  .pending-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 480px;
    background: rgba(255, 255, 255, 0.97);
    border-radius: 24px;
    padding: 44px 36px 36px;
    box-shadow: 
      0 25px 60px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    text-align: center;
    backdrop-filter: blur(20px);
  }

  /* Icon */
  .icon-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }

  .icon-pulse {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(99, 102, 241, 0.15);
    animation: pulse 2.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.3); opacity: 0; }
  }

  .icon-circle {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
  }

  /* Typography */
  h1 {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 4px;
    letter-spacing: -0.5px;
  }

  .subtitle {
    font-size: 15px;
    color: #64748b;
    margin-bottom: 24px;
    font-weight: 500;
  }

  /* Info box */
  .info-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 18px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #475569;
    font-weight: 500;
  }

  .info-row svg {
    color: #6366f1;
    flex-shrink: 0;
  }

  /* Steps */
  .steps {
    text-align: left;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 4px 0;
  }

  .step-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
  }

  .step.completed .step-dot {
    background: linear-gradient(135deg, #10b981, #059669);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .step.active .step-dot {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }

  .step.active .step-dot.pulsing {
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3); }
    50% { box-shadow: 0 4px 20px rgba(245, 158, 11, 0.6); }
  }

  .step-dot.inactive {
    background: #e2e8f0;
    color: #94a3b8;
  }

  .step-line {
    width: 2px;
    height: 16px;
    background: #10b981;
    margin-left: 15px;
    border-radius: 1px;
  }

  .step-line.faded {
    background: #e2e8f0;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
  }

  .step-title {
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
  }

  .step-desc {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 2px;
    line-height: 1.4;
  }

  /* Note */
  .note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    color: #64748b;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 28px;
    text-align: left;
    line-height: 1.5;
  }

  .note svg {
    color: #3b82f6;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-logout {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 20px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
    border: none;
    border-radius: 14px;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3);
  }

  .btn-logout:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.4);
  }

  .btn-home {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    background: transparent;
    color: #64748b;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
    font-family: inherit;
  }

  .btn-home:hover {
    border-color: #6366f1;
    color: #6366f1;
    background: rgba(99, 102, 241, 0.04);
  }

  /* Footer */
  .footer-text {
    position: relative;
    z-index: 10;
    margin-top: 32px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 500;
  }
</style>
